FROM mcr.microsoft.com/playwright/python:v1.62.0-noble

RUN pip install --no-cache-dir playwright==1.62.0

WORKDIR /workspace
COPY --chmod=0755 tests/browser_e2e/run_enh_e1a.py /workspace/tests/browser_e2e/run_enh_e1a.py
COPY --chmod=0755 tests/browser_e2e/run_enh_e3_predictive.py /workspace/tests/browser_e2e/run_enh_e3_predictive.py
COPY --chmod=0755 tests/browser_e2e/run_enh_e3.py /workspace/tests/browser_e2e/run_enh_e3.py
COPY --chmod=0755 tests/browser_e2e/run_enh_e6_family_stage_navigation.py /workspace/tests/browser_e2e/run_enh_e6_family_stage_navigation.py
COPY --chmod=0755 tests/browser_e2e/run_enh_e7_project_integration.py /workspace/tests/browser_e2e/run_enh_e7_project_integration.py
COPY --chmod=0755 tests/browser_e2e/run_enh_e8_g01_project_return.py /workspace/tests/browser_e2e/run_enh_e8_g01_project_return.py

ENTRYPOINT ["python", "tests/browser_e2e/run_enh_e1a.py"]
