ARIADNE_DATABASE_URL=postgresql+psycopg://ariadne:ariadne@database:5432/ariadne
ARIADNE_ARTIFACT_BACKEND=LOCAL
ARIADNE_ARTIFACT_ROOT=/state/objects
ARIADNE_WORKSPACE_ROOT=/state/workspaces
# Azure Blob (when ARIADNE_ARTIFACT_BACKEND=AZURE_BLOB)
# ARIADNE_AZURE_BLOB_CONTAINER=ariadne
# ARIADNE_AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=...
# Or use account URL plus a SAS/account-key credential:
# ARIADNE_AZURE_STORAGE_ACCOUNT_URL=https://example.blob.core.windows.net
# ARIADNE_AZURE_STORAGE_CREDENTIAL=...
ARIADNE_AUTH_MODE=development
ARIADNE_QUERY_ASYNC_THRESHOLD_BYTES=100000000
ARIADNE_QUERY_MAX_RESULT_ROWS=10000
ARIADNE_QUERY_MAX_SAMPLE_ROWS=50000
ARIADNE_WORKER_LEASE_SECONDS=300
