CAUSAL_ATELIER_DATABASE_URL=postgresql+psycopg://causal_atelier:causal_atelier@database:5432/causal_atelier
CAUSAL_ATELIER_ARTIFACT_BACKEND=LOCAL
CAUSAL_ATELIER_ARTIFACT_ROOT=/state/objects
CAUSAL_ATELIER_WORKSPACE_ROOT=/state/workspaces
# Azure Blob (when CAUSAL_ATELIER_ARTIFACT_BACKEND=AZURE_BLOB)
# CAUSAL_ATELIER_AZURE_BLOB_CONTAINER=causal-atelier
# CAUSAL_ATELIER_AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=...
# Or use account URL plus a SAS/account-key credential:
# CAUSAL_ATELIER_AZURE_STORAGE_ACCOUNT_URL=https://example.blob.core.windows.net
# CAUSAL_ATELIER_AZURE_STORAGE_CREDENTIAL=...
CAUSAL_ATELIER_AUTH_MODE=development
CAUSAL_ATELIER_QUERY_ASYNC_THRESHOLD_BYTES=100000000
CAUSAL_ATELIER_QUERY_MAX_RESULT_ROWS=10000
CAUSAL_ATELIER_QUERY_MAX_SAMPLE_ROWS=50000
CAUSAL_ATELIER_WORKER_LEASE_SECONDS=300
