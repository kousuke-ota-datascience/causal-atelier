{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ariadne:e11:prep04-1:p3-m02:method_config:draft1",
  "title": "P3-M02 method_config strict Method profile — DRAFT",
  "description": "PREP-04.1 internal validation DRAFT / NOT_FROZEN / NO_BACKEND_OR_SCIENCE_APPROVAL. Strict JSON shape does not validate scientific assumptions, Backend API, causal identification or CI coverage. No defaults.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ci_test_spec_ref",
    "tau_min",
    "tau_max",
    "alpha",
    "contemporaneous_rules_ref"
