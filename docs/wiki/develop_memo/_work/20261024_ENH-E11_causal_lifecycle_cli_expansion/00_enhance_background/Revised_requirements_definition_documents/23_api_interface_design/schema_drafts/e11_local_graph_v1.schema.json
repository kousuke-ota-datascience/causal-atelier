{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ariadne:e11:draft:graph:1",
  "title": "Ariadne local causal graph v1 — structural schema",
  "description": "Endpoint and temporal shape only; graph kind semantics, node reference integrity, DAG/PAG/CPDAG edge constraints and hash binding require semantic validators. Graph.content_hash is a semantic projection SHA256 over all Graph fields except content_hash; external ContentRef.sha256 covers full exact bytes. This avoids a cyclic self-hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "version_id",
    "parent_version_id",
    "nodes",
    "edges",
    "temporal",
    "provenance",
    "content_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "e11-local-graph/1"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "version_id": {
      "const": null,
      "description": "Current standalone Local CLI: null. Product GraphVersion integration/import is not implemented in E11."
    },
    "parent_version_id": {
      "const": null,
      "description": "Current standalone Local CLI: null; future Product interop requires separately approved new contract."
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/graphEdge"
      }
    },
    "temporal": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "time_index_policy",
            "lag_direction"
          ],
          "properties": {
            "time_index_policy": {
              "type": "string",
              "minLength": 1
            },
            "lag_direction": {
              "type": "string",
              "minLength": 1
            },
            "lag_unit": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "backend",
        "ci_test",
        "assumptions",
        "source_refs",
        "parent_graph_ref"
      ],
      "properties": {
        "method_id": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "ci_test": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "G01 P1-M06 semantically must equal Study.method.config.indep_test and be fisherz/chisq/gsq"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Declared assumption labels, not evidence of their scientific truth"
        },
        "source_refs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "question",
            "design",
            "dataset"
          ],
          "properties": {
            "question": {
              "$ref": "#/$defs/contentRef"
            },
            "design": {
              "$ref": "#/$defs/contentRef"
            },
            "dataset": {
              "$ref": "#/$defs/contentRef"
            }
          }
        },
        "parent_graph_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/contentRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Must be null for standalone G01 DISCOVER; future scientific successor only with verified immutable parent bytes"
        }
      },
      "description": "Typed scientific provenance with physical ContentRef verification and Study/Manifest joins performed outside JSON Schema; previous arbitrary-object accepted payloads may be incompatible."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "sha256 of JCS canonicalized Graph JSON projection excluding content_hash itself; distinct from ContentRef.sha256 of the full serialized file. Candidate requiring independent Review."
    }
  },
  "$defs": {
    "graphEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "source_mark",
        "target_mark",
        "lag"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "source_mark": {
          "enum": [
            "TAIL",
            "ARROW",
            "CIRCLE"
          ]
        },
        "target_mark": {
          "enum": [
            "TAIL",
            "ARROW",
            "CIRCLE"
          ]
        },
        "lag": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "relative_key",
        "sha256",
        "media_type",
        "schema_version"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "relative_key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[^\\\\\\u0000]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
