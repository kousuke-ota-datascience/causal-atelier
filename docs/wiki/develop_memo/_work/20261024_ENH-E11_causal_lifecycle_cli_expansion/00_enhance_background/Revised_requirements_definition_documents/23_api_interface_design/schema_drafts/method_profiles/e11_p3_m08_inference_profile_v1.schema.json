{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ariadne:e11:prep04-1:p3-m08:inference_profile:draft1",
  "title": "P3-M08 inference_profile strict Method profile — DRAFT",
  "description": "PREP-04.1 internal validation DRAFT / NOT_FROZEN / NO_BACKEND_OR_SCIENCE_APPROVAL. Strict JSON shape does not validate scientific assumptions, Backend API, causal identification or CI coverage. No defaults.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requested",
    "confidence_level"
  ],
  "properties": {
    "requested": {
      "type": "boolean"
    },
    "confidence_level": {
      "oneOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "requested": {
            "const": false
          }
        },
        "required": [
          "requested"
        ]
      },
      "then": {
        "properties": {
          "confidence_level": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "confidence_level": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          }
        }
      }
    }
  ]
}
