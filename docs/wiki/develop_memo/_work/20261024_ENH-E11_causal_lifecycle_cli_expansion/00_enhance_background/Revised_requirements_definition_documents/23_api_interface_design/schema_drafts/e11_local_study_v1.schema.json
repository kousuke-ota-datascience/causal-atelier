{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ariadne:e11:draft:study:1",
  "title": "E11 study v1 schema — PREP-02 review draft only",
  "description": "Unshipped strict local Study/1 draft updated under DEC-S02: explicit Study-only row opt-in, no reserved signed policy_ref. Method-specific scientific strict validation and runtime evidence still pending.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "run_id",
    "analysis_mode",
    "inputs",
    "estimand",
    "method",
    "inference",
    "randomness",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "const": "e11-local-study/1"
    },
    "operation": {
      "enum": [
        "DISCOVER",
        "IDENTIFY",
        "ESTIMATE",
        "REFUTE",
        "SENSITIVITY",
        "DIAGNOSE"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "analysis_mode": {
      "enum": [
        "EXPLORATORY",
        "CONFIRMATORY"
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "design",
        "dataset"
      ],
      "properties": {
        "question": {
          "$ref": "#/$defs/contentRef"
        },
        "design": {
          "$ref": "#/$defs/contentRef"
        },
        "graph": {
          "oneOf": [
            {
              "$ref": "#/$defs/contentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "dataset": {
          "$ref": "#/$defs/contentRef"
        },
        "identification": {
          "oneOf": [
            {
              "$ref": "#/$defs/contentRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "estimand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "population",
        "contrast"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "population": {
          "type": "string",
          "minLength": 1
        },
        "contrast": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/contentRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "backend",
        "config"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P[123]-M[0-9]{2}$"
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "object"
        }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "confidence_level"
      ],
      "properties": {
        "requested": {
          "type": "boolean"
        },
        "confidence_level": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "randomness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed"
      ],
      "properties": {
        "seed": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "row_export_requested"
      ],
      "properties": {
        "classification": {
          "enum": [
            "AGGREGATE",
            "RESTRICTED_ROW_LEVEL"
          ]
        },
        "row_export_requested": {
          "type": "boolean"
        }
      },
      "description": "Current S02 adopted local row mode: single explicit Study row_export_requested, default deny, no CLI duplicate confirmation, no policy_ref or signed approval. Privilege/root/Method/row bounds require independent runtime validation."
    }
  },
  "$defs": {
    "contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "relative_key",
        "sha256",
        "media_type",
        "schema_version"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "relative_key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[^\\\\\\u0000]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
