{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ariadne:e11:internal:scm_gaps:draft1",
  "title": "E11 internal scm_gaps typed scientific artifact — DRAFT",
  "description": "Not a public wire version. JSON shape alone does not prove scientific validity, privacy, backend or source lineage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "method_id",
    "source_ref",
    "treated_unit_ref",
    "preperiod_ref",
    "donor_ref",
    "weight_objective_ref",
    "periods",
    "inference_status"
  ],
  "properties": {
    "schema_version": {
      "const": "e11-internal-scm-gaps/draft1"
    },
    "method_id": {
      "const": "P3-M12"
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "relative_key",
        "sha256",
        "media_type",
        "schema_version"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "relative_key": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "treated_unit_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "relative_key",
        "sha256",
        "media_type",
        "schema_version"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "relative_key": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "preperiod_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "relative_key",
        "sha256",
        "media_type",
        "schema_version"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "relative_key": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "donor_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "relative_key",
        "sha256",
        "media_type",
        "schema_version"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "relative_key": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "weight_objective_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "relative_key",
        "sha256",
        "media_type",
        "schema_version"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "relative_key": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "periods": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "time_key",
          "phase",
          "observed",
          "counterfactual",
          "gap"
        ],
        "properties": {
          "time_key": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "enum": [
              "PRE",
              "POST"
            ]
          },
          "observed": {
            "type": "number"
          },
          "counterfactual": {
            "type": "number"
          },
          "gap": {
            "type": "number"
          }
        }
      }
    },
    "inference_status": {
      "const": "NOT_REQUESTED"
    }
  }
}
