{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ariadne:e11:prep04-1:p1-m05:design_profile:draft1",
  "title": "P1-M05 — DoWhy IV conditional complier LATE identification (B0) / design_profile",
  "description": "PREP-04.1 authoring DRAFT, strict internal Method profile; schema validity is not method availability, Backend API validation, independent Science PASS or Contract Freeze. Unknown keys rejected. No numeric or statistical defaults. ContentRef.schema_version remains null for unversioned internal Question/Design payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "design_id",
    "question_id",
    "design_kind",
    "treatment",
    "outcome",
    "instrument",
    "treatment_binary",
    "instrument_binary",
    "adjustment_columns",
    "monotonicity_direction",
    "relevance_assumption_ref",
    "independence_assumption_ref",
    "exclusion_assumption_ref",
    "monotonicity_assumption_ref",
    "consistency_assumption_ref",
    "graph_evidence_ref"
  ],
  "properties": {
    "design_id": {
      "type": "string",
      "minLength": 1
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "design_kind": {
      "const": "B0_BINARY_IV"
    },
    "treatment": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "instrument": {
      "type": "string",
      "minLength": 1
    },
    "treatment_binary": {
      "const": true
    },
    "instrument_binary": {
      "const": true
    },
    "adjustment_columns": {
      "type": "array",
      "maxItems": 0
    },
    "monotonicity_direction": {
      "enum": [
        "NONDECREASING",
        "NONINCREASING"
      ]
    },
    "relevance_assumption_ref": {
      "type": "string",
      "minLength": 1
    },
    "independence_assumption_ref": {
      "type": "string",
      "minLength": 1
    },
    "exclusion_assumption_ref": {
      "type": "string",
      "minLength": 1
    },
    "monotonicity_assumption_ref": {
      "type": "string",
      "minLength": 1
    },
    "consistency_assumption_ref": {
      "type": "string",
      "minLength": 1
    },
    "graph_evidence_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
