{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ariadne:e11:prep04-1:p1-m16:design_profile:draft1",
  "title": "P1-M16 design_profile strict Method profile — DRAFT",
  "description": "PREP-04.1 internal validation DRAFT / NOT_FROZEN / NO_BACKEND_OR_SCIENCE_APPROVAL. Strict JSON shape does not validate scientific assumptions, Backend API, causal identification or CI coverage. No defaults.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "design_id",
    "question_id",
    "design_kind",
    "base_effect_hash",
    "graph_evidence_ref",
    "candidate_adjustment_sets"
  ],
  "properties": {
    "design_id": {
      "type": "string",
      "minLength": 1
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "design_kind": {
      "const": "ADJUSTMENT_SENSITIVITY"
    },
    "base_effect_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "graph_evidence_ref": {
      "type": "string",
      "minLength": 1
    },
    "candidate_adjustment_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      }
    }
  }
}
