{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ariadne:e11:p1-m06:fci-design-evidence:1",
  "title": "P1-M06 FCI Design evidence: strict internal Method profile",
  "description": "Application-only strict P1-M06 design profile. Declared causal assumptions are not proof that they hold. CATEGORICAL variables require a complete declared category_codes universe; semantic validation checks strict token/ascending order and Dataset membership before FCI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "design_id",
    "question_id",
    "design_kind",
    "variables",
    "assumptions",
    "background_knowledge"
  ],
  "properties": {
    "design_id": {
      "type": "string",
      "minLength": 1
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "design_kind": {
      "const": "OBSERVATIONAL_GRAPH_DISCOVERY"
    },
    "variables": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "measurement_scale"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "measurement_scale": {
            "enum": [
              "CONTINUOUS",
              "CATEGORICAL"
            ]
          },
          "category_codes": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "integer"
            },
            "description": "For CATEGORICAL only: complete declared category-code universe, not observed unique values. Must be strictly ascending, exact JSON integer tokens (no 1.0/1e0, bool or coercion), within verified Backend integer representation; ordering/token exactness enforced by semantic validator."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "measurement_scale": {
                  "const": "CATEGORICAL"
                }
              },
              "required": [
                "measurement_scale"
              ]
            },
            "then": {
              "required": [
                "category_codes"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "category_codes"
                ]
              }
            }
          }
        ]
      }
    },
    "assumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "causal_markov_declared",
        "faithfulness_declared",
        "acyclicity_declared",
        "latent_confounding_possible",
        "sampling_unit"
      ],
      "properties": {
        "causal_markov_declared": {
          "type": "boolean"
        },
        "faithfulness_declared": {
          "type": "boolean"
        },
        "acyclicity_declared": {
          "type": "boolean"
        },
        "latent_confounding_possible": {
          "type": "boolean"
        },
        "sampling_unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "background_knowledge": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_edges",
            "forbidden_edges"
          ],
          "properties": {
            "required_edges": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/directedPair"
              }
            },
            "forbidden_edges": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/directedPair"
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "directedPair": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  }
}
